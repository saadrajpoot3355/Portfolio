# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (Nodemailer SMTP)
# IMPORTANT: Never commit actual passwords to Git!
# Provide credentials via local .env (which is git-ignored) or your cloud host's Environment Variables panel.
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-google-app-password

# Optional Custom SMTP settings (defaults to Gmail port 587 if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contact Email Receiver
# The email address that will receive contact form submissions
CONTACT_RECEIVER_EMAIL=saadrajpoot3355@gmail.com
